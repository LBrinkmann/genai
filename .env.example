# Database connection string (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://genai:genai@db:5432/genai

# Path to YAML experiment configuration inside the container
CONFIG_PATH=/app/config/experiment.yml

# ACCESS_KEY removed in 2026-05; replaced by ADMIN_USERNAME /
# ADMIN_PASSWORD_HASH (see backend/scripts/hash_password.py).

# Admin login — the only admin gate for /api/export/* and the new
# /api/admin/* endpoints. Operators log in via POST /api/auth/login,
# which sets a signed session cookie.
ADMIN_USERNAME=admin
# Generate with: poetry run python backend/scripts/hash_password.py
ADMIN_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Default true; set false only for local HTTP dev where the cookie
# would otherwise be dropped by the browser.
# COOKIE_SECURE=false
# Set true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For (e.g. Caddy in prod). Default false.
# TRUST_PROXY=false

# LLM provider API key (referenced via ${OPENAI_API_KEY} in YAML config)
OPENAI_API_KEY=sk-your-key-here

# Allowed CORS origin for the backend
CORS_ORIGIN=http://localhost:3000

# Frontend: backend API base URL (baked in at build time for prod)
REACT_APP_API_URL=http://localhost:8000

# Caddy: domain for the chat frontend (production only)
CADDY_DOMAIN=chat.example.com

# Caddy: domain for the API (production only)
CADDY_API_DOMAIN=api.example.com
